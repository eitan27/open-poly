# Cloudflare Pages custom headers.
#
# version.json is polled by the running app to detect new deploys, so it must
# never be served stale from a CDN/browser cache — always revalidate.
/version.json
  Cache-Control: no-cache

# The service worker must be re-checked on every load, or a new deploy can't
# replace the cached app (see src/pwa.ts).
/sw.js
  Cache-Control: no-cache
