# dependencies
node_modules/

# build output
dist/
dist-ssr/

# logs
*.log
npm-debug.log*

# agent issue reports (report_issue tool output)
mcp-server/issues.log.jsonl

# editor / OS
.DS_Store
*.local

# typescript build info
*.tsbuildinfo
