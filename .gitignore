*.tsbuildinfo
node_modules/.tmp/

# local claude settings
.claude/settings.local.json
# agent worktrees — full checkouts (node_modules and all) that land inside the
# repo. Untracked but not ignored, one `git add -A` away from a 500 MB commit,
# and vitest globs them, which silently triples the test count.
.claude/worktrees/

# wrangler local secrets
.dev.vars
.wrangler/

# Screenshots the verify scripts drop in the repo root
/dxf-import.png

# Maintainer deploy runbook. Deliberately untracked rather than deleted: the
# commands, the Cloudflare traps and the Turnstile notes are needed to deploy this
# project, but they are not useful to anyone reading the public repo. Keep your
# local copy — `git rm --cached` left it on disk, not `git rm`.
/docs/DEPLOY.md
