{
  "name": "open-poly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An open source, locally runnable, in-browser CAD application that stores your work locally.",
  "author": "Eitan Rosenfeld",
  "license": "GPL-3.0-or-later",
  "homepage": "https://openpoly.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eitan27/open-poly.git"
  },
  "bugs": {
    "url": "https://github.com/eitan27/open-poly/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev public --port 8788 --kv DRIVE_KV --binding DRIVE_MODE=mock --binding DRIVE_TRUST_FORWARDED=1 --compatibility-date 2025-09-01",
    "dev:api:google": "wrangler pages dev public --port 8788 --kv DRIVE_KV --binding DRIVE_MODE=google --binding DRIVE_TRUST_FORWARDED=1 --compatibility-date 2025-09-01",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p mcp-server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@salusoft89/planegcs": "^1.1.7",
    "dxf-parser": "^1.1.2",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "replicad-threejs-helper": "^0.23.0",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/opentype.js": "^1.3.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.0",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.151.1",
    "ws": "^8.21.0"
  }
}
